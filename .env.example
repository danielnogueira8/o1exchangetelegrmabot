# Create a read-only key at https://launch.o1.exchange/developers
O1_API_KEY=replace_with_o1_launchpad_key

# Create the bot with @BotFather, then add the bot and destination chat ID.
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_telegram_chat_id

# Base, Monad, and Robinhood Chain
CHAIN_IDS=8453,143,4663
MARKET=all

MAXIMUM_AGE_HOURS=6
MINIMUM_MARKET_CAP_USD=100000
MINIMUM_LIQUIDITY_USD=10000
MINIMUM_1H_TRADES=20

POLL_INTERVAL_SECONDS=60
SQLITE_PATH=./data/alerts.sqlite

# Use true to print alerts without contacting Telegram. Dry-run alerts are not
# saved, so switching to live mode will still deliver them.
DRY_RUN=false

# Useful for a single local or scheduled poll. Defaults to false.
RUN_ONCE=false
