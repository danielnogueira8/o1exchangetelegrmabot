{
  "name": "o1-exchange-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram alerts for newly launched o1 Exchange pairs.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "typescript": "^7.0.2"
  }
}
